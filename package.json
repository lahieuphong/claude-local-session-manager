{
  "name": "claude-local-session-manager",
  "productName": "Claude Local Session Manager",
  "version": "1.2.0",
  "description": "Unofficial local session manager for Claude Code/Desktop on Windows.",
  "author": "Claude Local Session Manager contributors",
  "license": "MIT",
  "homepage": "https://github.com/lahieuphong/claude-local-session-manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/lahieuphong/claude-local-session-manager.git"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "node scripts/i18n-check.mjs",
    "icon": "node scripts/generate-icon.mjs",
    "build": "electron-vite build",
    "clean": "node scripts/clean.mjs dist release out",
    "clean:dist": "node scripts/clean.mjs dist release",
    "dist": "yarn clean:dist && yarn build && electron-builder --win --x64 --publish never",
    "version:patch": "node scripts/version.mjs patch",
    "version:minor": "node scripts/version.mjs minor",
    "version:major": "node scripts/version.mjs major",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "release:assets": "node scripts/prepare-release-assets.mjs",
    "release:check-tag": "node scripts/check-tag-version.mjs"
  },
  "packageManager": "yarn@1.22.22",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
